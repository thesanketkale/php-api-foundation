# Application Environment
APP_NAME="PHP API Foundation"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Database Configuration (MySQL in production / SQLite for local tests)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=php_api_foundation
DB_USERNAME=db_user
DB_PASSWORD=secret_db_password

# Authentication & JWT Configuration
# Generate secure 256-bit key using: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security!
JWT_ALGORITHM=HS256
JWT_ISSUER=php-api-foundation
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=2592000

# CORS Security
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=86400

# Rate Limiting (auto, apcu, file)
RATE_LIMIT_DRIVER=auto
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW=60

# Logging
LOG_CHANNEL=app
LOG_LEVEL=info
LOG_PATH=storage/logs/app.log
